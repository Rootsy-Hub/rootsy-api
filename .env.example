# Misma base que rootsy-web. No uses SERVICE_ROLE en rutas de producto.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Verificación del JWT de usuario. Preferí el JWT Secret del dashboard
# (Settings → API). Si falta, se usa JWKS del proyecto.
SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# Candado server-to-server. El mismo valor va en rootsy-web (solo server).
ROOTSY_API_SECRET=

# Puerto local. Default 8787.
# PORT=8787

# Timeouts (ms). Default 8000 / 15000.
# SUPABASE_TIMEOUT_MS=8000
# REQUEST_TIMEOUT_MS=15000
